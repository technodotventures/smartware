{
  "name": "orp-kit",
  "private": true,
  "version": "0.2.0",
  "description": "ORP (working name): the memory and context protocol kit. Engine, server, clients, adapters, doctor and eval.",
  "license": "Apache-2.0",
  "type": "module",
  "workspaces": ["packages/*"],
  "engines": { "node": ">=22.13" },
  "scripts": {
    "build": "tsc -b packages/core packages/server packages/client packages/adapters",
    "test": "node --test --test-reporter=dot packages/*/test/*.test.js",
    "check:release": "node tools/release-check.mjs"
  },
  "devDependencies": {
    "typescript": "6.0.3",
    "@types/node": "22.18.0"
  }
}
