      "content": [{"type": "text", "text": "{\n  \"type\": \"user_message\",\n  \"message\": \"Hi Sam, I'm planning a trip to Kyoto in early April for the cherry blossoms.\",\n  \"time\": \"2025-03-29 08:01:02 AM UTC+0000\"\n}"}],
