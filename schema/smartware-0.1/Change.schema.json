{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://smartware.software/schema/0.1/Change",
 "title": "Change",
 "type": "object",
 "properties": {
  "cursor": {
   "type": "integer"
  },
  "at": {
   "type": "string",
   "description": "ISO 8601 timestamp; offsets are converted to UTC"
  },
  "op": {
   "type": "string"
  },
  "id": {
   "type": "string"
  },
  "tenant": {
   "type": "string"
  },
  "by": {
   "type": "string"
  },
  "version": {
   "anyOf": [
    {
     "type": "integer"
    },
    {
     "type": "null"
    }
   ]
  },
  "status": {
   "anyOf": [
    {
     "enum": [
      "active",
      "superseded",
      "retracted",
      "draft",
      "expired"
     ]
    },
    {
     "type": "null"
    }
   ]
  },
  "reason": {
   "type": "string"
  },
  "edge": {
   "type": "string"
  }
 },
 "required": [
  "cursor",
  "op",
  "id"
 ],
 "additionalProperties": false
}
