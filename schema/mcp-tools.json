       "retract",
       "redact",
       "purge"
      ]
     },
     "dry_run": {
      "type": "boolean"
     },
     "reason": {
      "type": "string"
     }
    },
    "required": [
     "ids"
    ],
    "additionalProperties": false
   },
   "annotations": {
    "readOnlyHint": false,
    "destructiveHint": true,
    "idempotentHint": true
   }
  },
