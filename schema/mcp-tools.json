     },
     "draft": {
      "type": "string"
     },
     "final": {
      "type": "string"
     },
     "note": {
      "type": "string"
     }
    },
    "required": [
     "target",
     "signal"
    ],
    "additionalProperties": false
   },
   "annotations": {
    "readOnlyHint": false,
    "idempotentHint": false
   }
  },
