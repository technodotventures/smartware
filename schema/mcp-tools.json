{
 "note": "MCP tool definitions by toolset (smartware serve --tools safe|full|mcp-memory)",
 "tools": [
  {
   "name": "smartware_recall",
   "title": "Recall memory",
   "set": [
    "safe",
    "full"
   ],
   "description": "Get budgeted, cited context from memory for a question.",
   "inputSchema": {
    "type": "object",
    "properties": {
     "query": {
      "type": "string"
     },
     "as_of": {
      "type": "string"
     },
     "budget_tokens": {
      "type": "integer",
      "minimum": 50,
      "maximum": 8000,
      "default": 1500
     },
     "include_history": {
      "type": "boolean"
     },
     "kinds": {
      "type": "array",
      "items": {
       "type": "string"
      }
     },
     "min_coverage": {
      "type": "number"
     }
    },
    "required": [
     "query"
    ],
    "additionalProperties": false
   },
   "annotations": {
    "readOnlyHint": true,
    "idempotentHint": true,
    "openWorldHint": false
   }
  },
  {
   "name": "smartware_remember",
   "title": "Remember",
   "set": [
    "safe"
   ],
   "description": "Store a durable fact, preference, decision or event. Use kind=fact with a claim when it replaces an earlier fact.",
   "inputSchema": {
    "type": "object",
    "properties": {
     "content": {
      "type": "string"
     },
     "kind": {
      "type": "string",
      "enum": [
       "fact",
       "preference",
       "event",
       "procedure"
      ]
     },
     "claim": {
      "type": "object",
      "properties": {
       "subject": {
        "type": "string"
       },
       "predicate": {
        "type": "string"
       },
       "object": {
        "type": "string"
       }
      },
      "required": [
       "subject",
       "predicate",
       "object"
      ],
      "additionalProperties": false
     },
     "event_time": {
      "type": "string"
     },
     "thread": {
      "type": "string"
     },
     "actor": {
      "type": "string"
     },
     "idempotency_key": {
      "type": "string"
     }
    },
    "required": [
     "content"
    ],
    "additionalProperties": false
   },
   "annotations": {
    "readOnlyHint": false,
    "idempotentHint": true,
    "destructiveHint": false
   }
  },
  {
   "name": "smartware_remember",
   "title": "Remember",
   "set": [
    "full"
   ],
   "description": "Store one or more memories. Use idempotency_key to make retries safe.",
   "inputSchema": {
    "type": "object",
    "properties": {
     "memories": {
      "type": "array",
      "items": {
       "type": "object",
       "properties": {
        "kind": {
         "type": "string",
         "enum": [
          "event",
          "document",
          "fact",
          "preference",
          "procedure",
          "observation",
          "summary",
          "profile",
          "entity"
         ]
        },
        "content": {
         "type": "string"
        },
        "actor": {
         "type": "string"
        },
        "role": {
         "type": "string"
        },
        "thread": {
         "type": "string"
        },
        "seq": {
         "type": "integer"
        },
        "claim": {
         "type": "object",
         "properties": {
          "subject": {
           "type": "string"
          },
          "predicate": {
           "type": "string"
          },
          "object": {
           "type": "string"
          },
          "cardinality": {
           "type": "string",
           "enum": [
            "one",
            "many"
           ]
          }
         },
         "required": [
          "subject",
          "predicate",
          "object"
         ],
         "additionalProperties": false
        },
        "event_time": {
         "type": "string"
        },
        "valid_from": {
         "type": "string"
        },
        "valid_to": {
         "type": "string"
        },
        "readers": {
         "type": [
          "array",
          "null"
         ],
         "items": {
          "type": "string"
         }
        },
        "labels": {
         "type": "array",
         "items": {
          "type": "string"
         }
        },
        "load": {
         "type": "string",
         "enum": [
          "always",
          "on_scope",
          "on_query"
         ]
        },
        "derived_from": {
         "type": "array",
         "items": {
          "type": "string"
         }
        },
        "origin": {
         "type": "string"
        },
        "scope": {
         "type": "string"
        },
        "id": {
         "type": "string"
        }
       },
       "required": [
        "content"
       ],
       "additionalProperties": false
      }
     },
     "mode": {
      "type": "string",
      "enum": [
       "append",
       "upsert",
       "supersede",
       "propose"
      ]
     },
     "idempotency_key": {
      "type": "string"
     },
     "if_version": {
      "type": "integer"
     }
    },
    "required": [
     "memories"
    ],
    "additionalProperties": false
   },
   "annotations": {
    "readOnlyHint": false,
    "idempotentHint": true,
    "destructiveHint": false
   }
  },
  {
