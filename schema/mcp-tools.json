    ],
    "additionalProperties": false
   },
   "annotations": {
    "readOnlyHint": false,
    "destructiveHint": true,
    "idempotentHint": true
   }
  },
  {
   "name": "smartware_forget",
   "title": "Forget",
   "set": [
    "full"
   ],
