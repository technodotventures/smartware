{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://orp.dev/schema/0.1/ForgetRequest",
 "title": "ForgetRequest",
 "type": "object",
 "properties": {
  "ids": {
   "type": "array",
   "items": {
    "type": "string"
   }
  },
  "mode": {
   "enum": [
    "retract",
    "redact",
    "purge"
   ]
  },
  "cascade": {
   "type": "boolean"
  },
  "dry_run": {
   "type": "boolean"
  },
  "reason": {
   "type": "string"
  },
  "allow_reingest": {
   "type": "boolean"
  }
 },
 "required": [
  "ids"
 ],
 "additionalProperties": false
}
