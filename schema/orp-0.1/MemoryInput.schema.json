{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://orp.dev/schema/0.1/MemoryInput",
 "title": "MemoryInput",
 "type": "object",
 "properties": {
  "id": {
   "type": "string",
   "minLength": 1,
   "pattern": "^[^~]+$"
  },
  "kind": {
   "type": "string",
   "description": "event | document | fact | preference | procedure | observation | summary | profile | entity, or x-<name>",
   "anyOf": [
    {
     "enum": [
      "event",
      "document",
      "fact",
      "preference",
      "procedure",
      "observation",
      "summary",
      "profile",
      "entity"
     ]
    },
    {
     "pattern": "^x-"
    }
   ]
  },
  "content": {
   "type": "string",
   "minLength": 1
  },
  "claim": {
   "anyOf": [
    {
     "type": "object",
     "properties": {
      "subject": {
       "type": "string",
       "minLength": 1
      },
      "predicate": {
       "type": "string",
       "minLength": 1
      },
      "object": {
       "type": "string",
       "minLength": 1
      },
      "cardinality": {
       "enum": [
        "one",
        "many"
       ],
       "default": "one"
      }
     },
     "required": [
      "subject",
      "predicate",
      "object"
     ],
     "additionalProperties": false
    },
    {
     "type": "null"
    }
   ]
  },
  "scope": {
   "type": "string"
  },
  "readers": {
   "anyOf": [
    {
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    {
     "type": "null"
    }
   ]
  },
  "writers": {
   "anyOf": [
    {
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    {
     "type": "null"
    }
   ]
  },
  "actor": {
   "type": "string"
  },
  "role": {
   "anyOf": [
    {
     "enum": [
      "user",
      "assistant",
      "system",
      "tool",
      "human",
      "connector"
     ]
    },
    {
     "type": "null"
    }
   ]
  },
  "origin": {
   "enum": [
    "observed",
    "extracted",
    "inferred",
    "human",
    "imported",
    "seed"
   ]
  },
  "thread": {
   "type": "string"
  },
  "seq": {
   "type": "integer"
  },
  "event_time": {
   "anyOf": [
    {
     "type": "string",
     "description": "ISO 8601 timestamp; offsets are converted to UTC"
    },
    {
     "type": "object",
     "properties": {
      "start": {
       "anyOf": [
        {
         "type": "string",
         "description": "ISO 8601 timestamp; offsets are converted to UTC"
        },
        {
         "type": "null"
        }
       ]
      },
      "end": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "granularity": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      }
     },
     "required": [],
     "additionalProperties": false
    },
    {
     "type": "null"
    }
   ]
  },
  "valid_from": {
   "anyOf": [
    {
     "type": "string",
     "description": "ISO 8601 timestamp; offsets are converted to UTC"
    },
    {
     "type": "null"
    }
   ]
  },
  "valid_to": {
   "anyOf": [
    {
     "type": "string",
     "description": "ISO 8601 timestamp; offsets are converted to UTC"
    },
    {
     "type": "null"
    }
   ]
  },
  "expires_at": {
   "anyOf": [
    {
     "type": "string",
     "description": "ISO 8601 timestamp; offsets are converted to UTC"
    },
    {
     "type": "null"
    }
   ]
  },
  "sources": {
   "type": "array",
   "items": {
    "type": "object",
    "properties": {
     "uri": {
      "type": "string"
     },
     "span": {
      "type": "string"
     },
     "hash": {
      "type": "string"
     },
     "observed_at": {
      "type": "string"
     }
    },
    "required": [
     "uri"
    ],
    "additionalProperties": false
   }
  },
  "derived_from": {
   "type": "array",
   "items": {
    "type": "string"
   }
  },
  "labels": {
   "type": "array",
   "items": {
    "type": "string"
   }
  },
  "load": {
   "enum": [
    "always",
    "on_scope",
    "on_query"
   ]
  },
  "confidence": {
   "type": "number",
   "minimum": 0,
   "maximum": 1
  },
  "support": {
   "type": "integer",
   "minimum": 0
  },
  "meta": {
   "type": "object",
   "description": "free-form; keys starting with _ are reserved for engines"
  },
  "supersedes": {
   "type": "array",
   "items": {
    "type": "string"
   }
  }
 },
 "required": [
  "content"
 ],
 "additionalProperties": false
}
