{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://orp.dev/schema/0.1/LinkRequest",
 "title": "LinkRequest",
 "type": "object",
 "properties": {
  "type": {
   "anyOf": [
    {
     "enum": [
      "about",
      "mentions",
      "part_of",
      "follows",
      "causes",
      "supports",
      "contradicts",
      "supersedes",
      "derived_from",
      "relates"
     ]
    },
    {
     "type": "string",
     "pattern": "^x-"
    }
   ]
  },
  "from": {
   "type": "string"
  },
  "to": {
   "type": "string"
  },
  "valid_from": {
   "anyOf": [
    {
     "type": "string",
     "description": "ISO 8601 timestamp; offsets are converted to UTC"
    },
    {
     "type": "null"
    }
   ]
  },
  "valid_to": {
   "anyOf": [
    {
     "type": "string",
     "description": "ISO 8601 timestamp; offsets are converted to UTC"
    },
    {
     "type": "null"
    }
   ]
  },
  "sources": {
   "type": "array",
   "items": {
    "type": "object",
    "properties": {
     "uri": {
      "type": "string"
     },
     "span": {
      "type": "string"
     },
     "hash": {
      "type": "string"
     },
     "observed_at": {
      "type": "string"
     }
    },
    "required": [
     "uri"
    ],
    "additionalProperties": false
   }
  }
 },
 "required": [
  "type",
  "from",
  "to"
 ],
 "additionalProperties": false
}
