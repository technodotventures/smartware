{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://orp.dev/schema/0.1/FeedbackRequest",
 "title": "FeedbackRequest",
 "type": "object",
 "properties": {
  "target": {
   "type": "string"
  },
  "signal": {
   "enum": [
    "used",
    "helpful",
    "wrong",
    "outdated",
    "draft_final"
   ]
  },
  "draft": {
   "type": "string"
  },
  "final": {
   "type": "string"
  },
  "note": {
   "type": "string"
  }
 },
 "required": [
  "target",
  "signal"
 ],
 "additionalProperties": false
}
