{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://orp.dev/schema/0.1/Error",
 "title": "Error",
 "type": "object",
 "properties": {
  "error": {
   "type": "object",
   "properties": {
    "code": {
     "enum": [
      "unsupported_parameter",
      "invalid_parameter",
      "version_conflict",
      "forbidden",
      "not_found",
      "budget_too_small",
      "degraded",
      "rate_limited",
      "unauthorized",
      "payload_too_large",
      "internal"
     ]
    },
    "message": {
     "type": "string"
    },
    "details": {
     "type": "object"
    }
   },
   "required": [
    "code",
    "message"
   ],
   "additionalProperties": false
  }
 },
 "required": [
  "error"
 ],
 "additionalProperties": false
}
