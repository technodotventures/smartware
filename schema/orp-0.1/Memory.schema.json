{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://orp.dev/schema/0.1/Memory",
 "title": "Memory",
 "type": "object",
 "properties": {
  "id": {
   "type": "string"
  },
  "tenant": {
   "type": "string"
  },
  "kind": {
   "type": "string",
   "description": "event | document | fact | preference | procedure | observation | summary | profile | entity, or x-<name>",
   "anyOf": [
    {
     "enum": [
      "event",
      "document",
      "fact",
      "preference",
      "procedure",
      "observation",
      "summary",
      "profile",
      "entity"
     ]
    },
    {
     "pattern": "^x-"
    }
   ]
  },
  "content": {
   "type": "string"
  },
  "claim": {
   "anyOf": [
    {
     "type": "object",
     "properties": {
      "subject": {
       "type": "string",
       "minLength": 1
      },
      "predicate": {
       "type": "string",
       "minLength": 1
      },
      "object": {
       "type": "string",
       "minLength": 1
      },
      "cardinality": {
       "enum": [
        "one",
        "many"
       ],
       "default": "one"
      }
     },
     "required": [
      "subject",
      "predicate",
      "object"
     ],
     "additionalProperties": false
    },
    {
     "type": "null"
    }
   ]
  },
  "scope": {
   "type": "string"
  },
  "readers": {
   "anyOf": [
    {
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    {
     "type": "null"
    }
   ]
  },
  "writers": {
   "anyOf": [
    {
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    {
     "type": "null"
    }
   ]
  },
  "actor": {
   "type": "string"
  },
  "role": {
   "type": "string"
  },
  "origin": {
   "enum": [
    "observed",
    "extracted",
    "inferred",
    "human",
    "imported",
    "seed"
   ]
  },
  "thread": {
   "type": "string"
  },
  "seq": {
   "type": "integer"
  },
  "observed_at": {
   "anyOf": [
    {
     "type": "string",
     "description": "ISO 8601 timestamp; offsets are converted to UTC"
    },
    {
     "type": "null"
    }
   ]
  },
  "event_time": {
   "anyOf": [
    {
     "type": "string",
     "description": "ISO 8601 timestamp; offsets are converted to UTC"
    },
    {
     "type": "null"
    }
   ]
  },
  "valid_from": {
   "anyOf": [
    {
     "type": "string",
     "description": "ISO 8601 timestamp; offsets are converted to UTC"
    },
    {
     "type": "null"
    }
   ]
  },
  "valid_to": {
   "anyOf": [
    {
     "type": "string",
     "description": "ISO 8601 timestamp; offsets are converted to UTC"
    },
    {
     "type": "null"
    }
   ]
  },
  "expires_at": {
   "anyOf": [
    {
     "type": "string",
     "description": "ISO 8601 timestamp; offsets are converted to UTC"
    },
    {
     "type": "null"
    }
   ]
  },
  "status": {
   "enum": [
    "active",
    "superseded",
    "retracted",
    "draft",
    "expired"
   ]
  },
  "supersedes": {
   "type": "array",
   "items": {
    "type": "string"
   }
  },
  "superseded_by": {
   "anyOf": [
    {
     "type": "string"
    },
    {
     "type": "null"
    }
   ]
  },
  "version": {
   "type": "integer",
   "minimum": 1
  },
  "sources": {
   "type": "array",
   "items": {
    "type": "object",
    "properties": {
     "uri": {
      "type": "string"
     },
     "span": {
      "type": "string"
     },
     "hash": {
      "type": "string"
     },
     "observed_at": {
      "type": "string"
     }
    },
    "required": [
     "uri"
    ],
    "additionalProperties": false
   }
  },
  "derived_from": {
   "type": "array",
   "items": {
    "type": "string"
   }
  },
  "support": {
   "type": "integer",
   "minimum": 0
  },
  "confidence": {
   "type": "number",
   "minimum": 0,
   "maximum": 1
  },
  "labels": {
   "type": "array",
   "items": {
    "type": "string"
   }
  },
  "load": {
   "enum": [
    "always",
    "on_scope",
    "on_query"
   ]
  },
  "meta": {
   "type": "object"
  },
  "written_by": {
   "type": [
    "string",
    "null"
   ],
   "description": "authenticated writer (actor is asserted)"
  }
 },
 "required": [
  "id",
  "tenant",
  "kind",
  "content",
  "readers",
  "origin",
  "observed_at",
  "status",
  "version"
 ],
 "additionalProperties": false
}
